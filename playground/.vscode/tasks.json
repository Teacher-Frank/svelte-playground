{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "playground",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/acctest-env.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "custom",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "starting dev server",
          "endsPattern": "VITE.*ready in"
        },
        "fileLocation": "autoDetect",
        "pattern": {
          "regexp": "^$",
          "message": 1
        }
      }
    }
  ]
}
