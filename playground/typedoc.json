{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/routes/proxmox/+page.server.ts"],
  "entryPointStrategy": "resolve",
  "out": "docs",
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "**/.svelte-kit/**"],
  "externalPattern": ["**/.svelte-kit/**"],
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "gitRevision": "main",
  "skipErrorChecking": true,
  "validation": {
    "notExported": false
  },
  "includeVersion": true,
  "categorizeByGroup": true,
  "searchInComments": true,
  "maxTypeConversionDepth": 10,
  "sort": ["source-order"]
}
